<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LumaFrame</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Which build produced this binary. `CFBundleVersion` cannot carry it: Apple
	     requires that key to be a dotted number, and a commit hash there can make an
	     install fail. A custom key is unconstrained, and the app prints it at launch so a
	     log file names the commit it came from. Defaults to `local` in the project and is
	     overridden by CI. -->
	<key>LumaFrameBuild</key>
	<string>$(LUMAFRAME_BUILD)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Without these two, Documents is invisible in the Files app: the app does not
	     appear under "On My iPhone" and its folder cannot be opened in place. The
	     capability report and the log file are only useful if the user can actually get
	     them off the device, so both are required rather than optional. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>LumaFrame uses the camera to capture photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>LumaFrame saves captured photos to your photo library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>LumaFrame uses the microphone only when video capture is enabled.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
