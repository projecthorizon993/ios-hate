<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain platform theme. The app is Compose only, so there is no need for
         AppCompat or Material Components XML themes. -->
    <style name="Theme.LumaFrame" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
